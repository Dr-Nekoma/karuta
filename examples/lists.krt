append[[], [], []].
append[[], Out, Out].
append[Out, [], Out].
append[[H|Tail], Second, [H|Mid]] :- append[Tail, Second, Mid].

add[[], [], []].
add[[H1|Tail1], [H2|Tail2], [HR|TailOut]] :-
    plus[H1, H2, HR],
    add[Tail1, Tail2, TailOut].

eq[A, A].
