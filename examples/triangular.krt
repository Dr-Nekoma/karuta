plus[Out, nil, Out].

plus[succ[Prev], X, Out] :- debug[], plus[Prev, succ[X], Out].
plus[nil, Out, Out].

triangle[N, Out] :- debug[], triangle[N, nil, Out].

triangle[succ[Prev], Acc, Out] :-
  debug[],
  plus[succ[Prev], Acc, NewAcc],
  debug[],
  triangle[Prev, NewAcc, Out].

triangle[nil, Out, Out].

triangle[succ[nil], Out]?
